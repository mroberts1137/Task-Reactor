{
  "compilerOptions": {
    "types": ["node", "jest"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "target": "ES6",
    "module": "commonjs",
    "jsx": "react",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "lib": ["dom", "esnext"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "src/api/axios.ts",
    "src/components/**/*.tsx",
    "src/styles/themes/**/*.ts",
    "src/components/calendarbox/CustomCalendar.js"
  ]
}
